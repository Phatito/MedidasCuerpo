      "css": ".ds-cells{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.5px;background:#d2d8e1;border:1.5px solid #14171c;border-radius:10px;overflow:hidden}.ds-cell{font-family:var(--font,'Archivo Variable',system-ui,sans-serif);display:flex;flex-direction:column;gap:4px;min-height:96px;padding:12px 14px;border:0;background:#fff;color:#14171c;text-align:left;cursor:pointer;transition:background-color .15s ease-out}.ds-cell:hover{background:#f5f7ff}.ds-cell:focus-visible{outline:2.5px solid #1f45c9;outline-offset:-3px}.ds-cell .k{font-size:.78rem;font-weight:650;font-stretch:82%;color:#535d6c}.ds-cell .v{font-size:2.1rem;font-weight:720;font-stretch:72%;line-height:1;font-variant-numeric:tabular-nums}.ds-cell small{font-size:.8rem;font-weight:600;color:#535d6c}.ds-cell .p{display:flex;justify-content:space-between;align-items:center}.ds-cell .st{font-size:.78rem;font-weight:800;color:#c21f3a}.ds-cell .d{font-size:.8rem;font-weight:700;color:#535d6c;font-variant-numeric:tabular-nums}.ds-cell .d.good{color:#0d7a4e}.ds-cell .d svg{width:.8em;height:.8em;fill:currentColor}"
